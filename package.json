{
  "name": "poker-ledger-web",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "fixtures": "node tools/make-fixtures.ts",
    "reference": "bash reference/run.sh",
    "check:privacy": "node tools/check-privacy.ts",
    "parity": "node tools/parity.ts --reference fixtures/synthetic-reference --data fixtures/synthetic",
    "parity:real": "PARITY_REAL=1 vitest run packages/core/test/parity.test.ts -t 'real data'"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
